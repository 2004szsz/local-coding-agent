{
  "name": "local-coding-agent",
  "version": "1.1.0",
  "description": "本地编码智能体。Agent、技能、工具、记忆、提示词分层，HTTP 与网页只做外壳。",
  "language": "zh-CN",
  "entrypoint": "run.py",
  "modules": {
    "agents": "agents",
    "skills": "skills",
    "tools": "tools",
    "memory": "memory",
    "prompts": "prompts",
    "tests": "tests",
    "scripts": "scripts",
    "http": "app"
  },
  "runtime": {
    "host": "127.0.0.1",
    "port": 8000,
    "workspace_root": "./workspaces/demo",
    "history_db": "./data/history.db",
    "vector_store": "./data/chroma"
  }
}
